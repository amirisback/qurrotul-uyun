# ============================================
# Common Environment Variables
# Shared across all environments (local & prod)
# ============================================

# --- App ---
NEXT_PUBLIC_APP_NAME="Qurrotul Uyun"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- API ---
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_API_TIMEOUT=30000

# --- Features Flags ---
NEXT_PUBLIC_ENABLE_PWA=true

# --- SEO ---
NEXT_PUBLIC_SITE_TITLE="Qurrotul Uyun"
NEXT_PUBLIC_SITE_DESCRIPTION="Qurrotul Uyun — Panduan Rumah Tangga & Adab Pernikahan Islami"

# --- Locale ---
NEXT_PUBLIC_DEFAULT_LOCALE="id"

# --- Obfuscation (Sqids) ---
SQIDS_ALPHABET="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
